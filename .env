# MITOGAMES — local development environment
APP_NAME=MITOGAMES
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database
DATABASE_URL=postgresql+asyncpg://postgres:Nadiya666@localhost:5432/mitogames

# Security
SECRET_KEY=dev-secret-change-me-in-production-9f8a7b6c5d4e3f2a1b0c
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_COST=12

# YouTube (leave blank to run offline; video submission will fail validation until set)
YOUTUBE_API_KEY=
YOUTUBE_MAX_DURATION_SECONDS=3600
YOUTUBE_MIN_DURATION_SECONDS=10

# AI / LLM (leave OPENAI_API_KEY blank to use the Stub provider for offline testing)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_MAX_TRANSCRIPT_CHARS=12000
AI_SUBJECT_CONFIDENCE_THRESHOLD=0.6
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
