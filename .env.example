# ============================================================
# MITOGAMES Backend — Environment Variables
# Copy this file to ".env" and fill in real values.
# Never commit the real .env file.
# ============================================================

# --- App ---
APP_NAME=MITOGAMES
ENVIRONMENT=development            # development | staging | production
DEBUG=true
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Database (async driver = asyncpg) ---
DATABASE_URL=postgresql+asyncpg://postgres:Nadiya666@localhost:5432/mitogames

# --- Security ---
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_COST=12

# --- YouTube ---
YOUTUBE_API_KEY=your-youtube-data-api-key
YOUTUBE_MAX_DURATION_SECONDS=3600
YOUTUBE_MIN_DURATION_SECONDS=10

# --- AI / LLM ---
AI_PROVIDER=openai                 # openai | (extensible)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Verbatim YouTube Chemistry Lab generation
GEMINI_API_KEY=your-gemini-api-key
AI_MAX_TRANSCRIPT_CHARS=12000
AI_SUBJECT_CONFIDENCE_THRESHOLD=0.6
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
